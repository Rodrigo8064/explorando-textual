Screen {
    layout: vertical;
}

#body {
    height: 1fr;
}

/* ---- Painel esquerdo: 1/3 da largura ---- */
#left-panel {
    width: 1fr;
    border: round $primary;
    border-title-color: $text;
    padding: 0 1;
}

#left-panel Collapsible {
    margin-bottom: 1;
}

ListView {
    height: auto;
    max-height: 10;
}

ListItem {
    padding: 0 1;
}

/* ---- Painel direito: 2/3 da largura ---- */
#right-panel {
    width: 2fr;
}

#description-box {
    height: auto;
    min-height: 5;
    border: round $accent;
    padding: 1 2;
    margin-bottom: 1;
    content-align: left top;
}

#log-box {
    height: 1fr;
    border: round $success;
    padding: 0 1;
}
